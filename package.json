{
  "name": "aiim-service",
  "version": "0.0.0",
  "private": true,
  "description": "AIIM 后端：微信操作与运营服务（apps: gateway/brain/scheduler/panel + packages: kernel/contracts/store）。契约见 ../aiim。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/brain",
    "apps/gateway",
    "apps/server"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "tsx --test packages/kernel/test/*.test.ts apps/brain/test/*.test.ts apps/gateway/test/*.test.ts apps/server/test/*.test.ts",
    "start": "tsx apps/server/src/main.ts",
    "build": "echo \"(skeleton) no build yet\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
